# ==============================================================================
# 🚀 HARNESS BUDDY: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and add your API keys:
#
#   cp .env.example .env   (Linux/macOS/Git Bash)
#   copy .env.example .env (Windows Command Prompt)
# ==============================================================================

# 1. xKiro AI Platform (Provides Qwen 3.8 Max 1M, Mistral Codestral, MiniMax M3 Vision)
# Get your free key at: https://api.xkiro.com
XKIRO_API_KEY=your_xkiro_api_key_here
XKIRO_BASE_URL=https://api.xkiro.com/v1

# 2. Dahl Global Inference (Official DeepSeek V4 Flash with 100 Million Free Tokens)
# Get your free key at: https://inference.dahl.global
DAHL_API_KEY=your_dahl_api_key_here
DAHL_BASE_URL=https://inference.dahl.global/v1

# 3. Model Role Assignments (Defaults to verified high-performance free models)
DEFAULT_MODEL=qwen/qwen3.8-max:free
CODER_MODEL=mistralai/codestral-2508
INDEXER_MODEL=qwen/qwen3-coder-plus:free
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
TOOL_MODEL=mistralai/devstral-medium

# 4. ShadowVault AI Reasoner & Forensic Settings
SHADOW_VAULT_AI_KEY=your_xkiro_or_gemini_api_key
SHADOW_VAULT_AI_URL=https://api.xkiro.com/v1/chat/completions
SHADOW_VAULT_AI_MODEL=qwen/qwen3.8-max:free

# 5. Local Server Ports
PORT=3080
SHADOW_VAULT_PORT=4567
