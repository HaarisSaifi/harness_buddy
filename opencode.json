{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "xkiro": {
      "npm": "@ai-sdk/openai",
      "name": "xKiro AI Platform",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XKIRO_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen 3.8 Max (1M Flagship Brain)",
          "id": "qwen/qwen3.8-max:free"
        },
        "codestral": {
          "name": "Mistral Codestral 2508 (Fullstack Logic)",
          "id": "mistralai/codestral-2508"
        },
        "qwen-coder": {
          "name": "Qwen 3 Coder Plus (1M Code Specialist)",
          "id": "qwen/qwen3-coder-plus:free"
        },
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max Designer (UI/UX & CSS)",
          "id": "qwen/qwen3.7-max:free"
        },
        "minimax-m3": {
          "name": "MiniMax M3 (1M Multimodal Vision)",
          "id": "minimax/minimax-m3:free"
        },
        "devstral": {
          "name": "Mistral Devstral Medium (DevOps)",
          "id": "mistralai/devstral-medium"
        }
      }
    },
    "dahl": {
      "npm": "@ai-sdk/openai",
      "name": "Dahl Global (100M Free Tokens)",
      "options": {
        "baseURL": "https://inference.dahl.global/v1",
        "apiKey": "{env:DAHL_API_KEY}"
      },
      "models": {
        "deepseek-v4": {
          "name": "DeepSeek V4 Flash (Official)",
          "id": "deepseek-ai/DeepSeek-V4-Flash-0731"
        },
        "minimax-m27": {
          "name": "MiniMax M2.7",
          "id": "MiniMaxAI/MiniMax-M2.7"
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai",
      "name": "NVIDIA NIM (Free Endpoints)",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "models": {
        "glm-5.3": {
          "name": "Z.ai GLM 5.3 (753B Heavy Logic)",
          "id": "z-ai/glm-5.3"
        },
        "glm-5.3-flash": {
          "name": "Z.ai GLM 5.3 Flash (320B Multimodal)",
          "id": "z-ai/glm-5.3-flash"
        },
        "kimi-k3": {
          "name": "Moonshot Kimi K3 (2.8T Agentic Brain)",
          "id": "moonshotai/kimi-k3"
        },
        "deepseek-v4.1": {
          "name": "DeepSeek V4.1 Flash",
          "id": "deepseek-ai/deepseek-v4.1-flash"
        }
      }
    },
    "agentrouter": {
      "npm": "@ai-sdk/openai",
      "name": "Agent Router (Elite Tier)",
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}",
        "headers": {
          "User-Agent": "RooCode/0.15.0"
        }
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5 (Frontier Architecture & Logic)",
          "id": "claude-opus-5"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra (Next-Gen Reasoning)",
          "id": "gpt-6-astra"
        },
        "deepseek-v4": {
          "name": "DeepSeek V4 Flash",
          "id": "deepseek-v4-flash"
        }
      }
    }
  }
}
